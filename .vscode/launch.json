{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug api-app",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 9091
            },
            "preLaunchTask": "func: start api-app",
            "justMyCode": true
        },
        {
            "name": "Debug worker-app",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 9092
            },
            "preLaunchTask": "func: start worker-app",
            "justMyCode": true
        },
        {
            "name": "Python: current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: debug tests",
            "type": "debugpy",
            "request": "launch",
            "purpose": [
                "debug-test"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ],
    "compounds": [
        {
            "name": "Debug all Function Apps",
            "configurations": [
                "Debug api-app",
                "Debug worker-app"
            ],
            "stopAll": true
        }
    ]
}
